# ── Database ──────────────────────────────────────────────────────────────
# PRODUCTION (Supabase PostgreSQL):
# Paste your Supabase URI connection string here (with ?sslmode=require).
# Example:
#   DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# MySQL (optional for local dev):
# DATABASE_URL=mysql+pymysql://postpulse:postpulse_pw@localhost:3306/postpulse
#
# SQLite (zero setup fallback): leave blank/unset to use local SQLite (postpulse.db)
DATABASE_URL=


# ── Model bundle ─────────────────────────────────────────────────────────
# Optional override for the location of the trained model bundle. The backend
# also looks in backend/models/ (shipped) and the repo's ml/models/. Set only
# if you store the bundle elsewhere (e.g. a mounted volume).
# MODEL_BUNDLE_PATH=

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a real random value for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Email of the account that should be auto-promoted to admin on first
# registration with this address. Leave blank to skip auto-bootstrap.
ADMIN_BOOTSTRAP_EMAIL=

# ── Email (optional) ─────────────────────────────────────────────────────
# If left blank, verification links are printed to the backend console
# instead of emailed - the app works fully without any email setup.
# NEVER put your real Google account password here. Use a Gmail "App
# Password" instead: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=PostPulse

FRONTEND_URL=http://localhost:5173

# ── Production deployment ────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS. Defaults to
# localhost dev ports if unset. Set this to your deployed frontend's URL(s):
#   ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
