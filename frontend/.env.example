# Base URL of the PostPulse backend API.
# LOCAL:  http://localhost:8000/api
# PROD:   your deployed Render backend URL + /api, e.g. https://postpulse-api.onrender.com/api
#
# IMPORTANT: Vite embeds this into the JS bundle AT BUILD TIME, not runtime.
# On Vercel, set it as a build/review/preview environment variable (Project
# Settings -> Environment Variables), or Vercel will use this default.
VITE_API_URL=http://localhost:8000/api

